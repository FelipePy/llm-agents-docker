#!/usr/bin/env bash
# Executa um agente LLM (Codex, Claude Code) em um container que enxerga
# apenas o projeto atual.
#
# Uso:
#   jarvis                 menu para escolher o agente
#   jarvis claude [args]   abre o Claude Code (com Remote Control)
#   jarvis codex [args]    abre o Codex
#   jarvis zsh             abre um shell no container
#   jarvis ui [--stop]     abre a interface (imprime a URL) ou a encerra
#   jarvis --build         (re)constroi a imagem
#
# Variaveis:
#   AGENT_WORKDIR             projeto a montar (padrao: diretorio atual)
#   CODEX_VERSION, CLAUDE_CODE_VERSION   versoes usadas no --build
#                             (padrao: as versoes ja instaladas na imagem)
#   LLM_AGENT_NO_UPDATE_CHECK=1          nao procura versoes novas ao abrir
#   LLM_AGENT_NO_REMOTE_CONTROL=1        abre o Claude Code sem Remote Control
#   LLM_AGENT_UI_PORT         porta da interface (padrao: 7777)
#   LLM_AGENT_DOCKER          comando do Docker (padrao: docker). Ex.: em um
#                             servidor onde so outro usuario acessa o Docker,
#                             "sudo -u dockeruser docker". O install.sh --docker
#                             salva esse valor em ~/.config/llm-agent/config.
set -euo pipefail

if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
  sed -n '2,/^set -euo/{/^set -euo/d;s/^# \{0,1\}//;p}' "$(readlink -f "${BASH_SOURCE[0]}")"
  exit 0
fi

# A interface roda no host, sem Docker, e nao depende do diretorio atual.
if [ "${1:-}" = "ui" ]; then
  shift
  exec "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/app/ui.sh" "$@"
fi

repo_dir="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"

config_file="${XDG_CONFIG_HOME:-$HOME/.config}/llm-agent/config"
# shellcheck source=/dev/null
[ -f "$config_file" ] && . "$config_file"
# So as chamadas ao Docker usam esse comando; todo o resto (home, UID,
# credenciais, projeto) e do usuario que executa o llm-agent.
read -ra docker_cmd <<< "${LLM_AGENT_DOCKER:-docker}"

# O build nao monta nenhum projeto; o compose so exige que a variavel exista.
if [ "${1:-}" = "--build" ]; then
  AGENT_WORKDIR="$repo_dir"
fi

# Caminho fisico (sem symlinks), igual ao que os CLIs usam no host; assim o
# historico de chats do projeto e o mesmo dentro e fora do container.
AGENT_WORKDIR="$(cd "${AGENT_WORKDIR:-$PWD}" && pwd -P)"
case "$AGENT_WORKDIR" in
  / | "$(cd "$HOME" && pwd -P)")
    echo "jarvis: execute dentro de um projeto, nao em '$AGENT_WORKDIR'" >&2
    echo "(montar a home ou a raiz exporia todos os seus arquivos ao agente)." >&2
    exit 1
    ;;
esac
HOST_UID="$(id -u)" HOST_GID="$(id -g)"

# Arquivos temporarios lidos pelo docker compose. Ficam legiveis para outros
# usuarios porque o Docker pode rodar como outro usuario (LLM_AGENT_DOCKER).
tmp_dir="$(mktemp -d "${TMPDIR:-/tmp}/llm-agent.XXXXXX")"
trap 'rm -rf "$tmp_dir"' EXIT
chmod 755 "$tmp_dir"
env_file="$tmp_dir/env"
override="$tmp_dir/override.yml"

# Variaveis do docker-compose.yml vao por --env-file, e nao pelo ambiente,
# para sobreviverem a um sudo (que descarta o ambiente do usuario).
compose() {
  {
    printf "%s='%s'\n" \
      AGENT_WORKDIR "$AGENT_WORKDIR" \
      HOST_HOME "$HOME" \
      HOST_UID "$HOST_UID" \
      HOST_GID "$HOST_GID" \
      COLORTERM "${COLORTERM:-truecolor}" \
      TERM "${TERM:-xterm-256color}"
    [ -z "${CLAUDE_CODE_VERSION:-}" ] || printf "CLAUDE_CODE_VERSION='%s'\n" "$CLAUDE_CODE_VERSION"
    [ -z "${CODEX_VERSION:-}" ] || printf "CODEX_VERSION='%s'\n" "$CODEX_VERSION"
  } > "$env_file"
  chmod 644 "$env_file"
  # O ambiente teria prioridade sobre o --env-file; remove para valer o arquivo.
  env -u AGENT_WORKDIR -u HOST_HOME -u HOST_UID -u HOST_GID \
    -u CLAUDE_CODE_VERSION -u CODEX_VERSION \
    "${docker_cmd[@]}" compose --env-file "$env_file" -f "$repo_dir/docker-compose.yml" "$@"
}

# Sem argumentos: pergunta qual agente abrir. Os agentes rodam em modo
# autonomo, ja que o container limita o que eles conseguem acessar.
if [ $# -eq 0 ] && [ -t 0 ]; then
  echo "Qual agente abrir em $AGENT_WORKDIR?"
  echo "  1) Claude Code"
  echo "  2) Codex"
  echo "  3) Shell (zsh)"
  read -rp "Escolha [1-3]: " choice
  case "$choice" in
    1) set -- claude --dangerously-skip-permissions ;;
    2) set -- codex --dangerously-bypass-approvals-and-sandbox ;;
    3) set -- zsh ;;
    *) echo "jarvis: opcao invalida: '$choice'" >&2; exit 1 ;;
  esac
fi

image="local/llm-agent-safe:latest"

# Versao de um CLI instalada na imagem (labels definidos no Dockerfile).
image_version() {
  local v
  v="$("${docker_cmd[@]}" image inspect --format "{{ index .Config.Labels \"llm-agent.$1\" }}" "$image" 2>/dev/null)" || return 0
  [ "$v" = "<no value>" ] || echo "$v"
}

# Ultima versao publicada no npm; vazio se offline ou sem curl.
npm_latest_version() {
  command -v curl >/dev/null || return 0
  curl -fsS --max-time 3 "https://registry.npmjs.org/$1/latest" 2>/dev/null \
    | grep -o '"version":"[^"]*"' | head -1 | cut -d'"' -f4 || true
}

# Sem versao explicita, mantem as ja instaladas na imagem (um rebuild nao
# desfaz atualizacoes); sem imagem, vale o padrao do docker-compose.yml.
build_image() {
  : "${CLAUDE_CODE_VERSION:=$(image_version claude-code)}"
  : "${CODEX_VERSION:=$(image_version codex)}"
  compose build "$@"
}

# Ao abrir um agente, oferece atualizar se houver versao nova no npm.
check_update() { # label pacote-npm variavel-de-versao nome
  local current latest answer
  current="$(image_version "$1")"
  [ -n "$current" ] || return 0
  latest="$(npm_latest_version "$2")"
  [ -n "$latest" ] && [ "$latest" != "$current" ] || return 0
  [ "$(printf '%s\n%s\n' "$current" "$latest" | sort -V | tail -1)" = "$latest" ] || return 0

  read -rp "Nova versao do $4: $current -> $latest. Atualizar agora? [s/N] " answer
  case "$answer" in
    s | S | sim | y | Y | yes) ;;
    *) return 0 ;;
  esac
  if (printf -v "$3" '%s' "$latest"; build_image); then
    echo "$4 atualizado para $latest."
  else
    echo "jarvis: falha ao atualizar; seguindo com a versao $current." >&2
  fi
}

if [ -t 0 ] && [ -z "${LLM_AGENT_NO_UPDATE_CHECK:-}" ]; then
  case "${1:-}" in
    claude) check_update claude-code @anthropic-ai/claude-code CLAUDE_CODE_VERSION "Claude Code" ;;
    codex) check_update codex @openai/codex CODEX_VERSION "Codex" ;;
  esac
fi

# Estado dos CLIs precisa existir antes do mount (o compose nao cria).
mkdir -p "$HOME/.codex" "$HOME/.claude"
if [ ! -e "$HOME/.claude.json" ]; then
  echo '{}' > "$HOME/.claude.json"
  chmod 600 "$HOME/.claude.json"
fi

# Mounts opcionais: so entram se existirem no host.
optional_volumes=""
add_mount() { # origem destino read_only
  [ -e "$1" ] || return 0
  optional_volumes+="      - type: bind
        source: \"${1//\$/\$\$}\"
        target: \"$2\"
        read_only: $3
"
}
add_mount "$HOME/.ssh"         /home/agent/.ssh         true
add_mount "$HOME/.config/gh"   /home/agent/.config/gh   true
add_mount "$HOME/.gitconfig"   /home/agent/.gitconfig   true
# Skills em ~/.claude/skills podem ser symlinks para ../../.agents/skills/...
add_mount "$HOME/.agents"      /home/agent/.agents      false
add_mount "$HOME/.zshrc"       /home/agent/.zshrc       true
add_mount "$HOME/.oh-my-zsh"   /home/agent/.oh-my-zsh   true
add_mount "$HOME/.nvm"         /home/agent/.nvm         true
add_mount "$HOME/.pyenv"       /home/agent/.pyenv       true
add_mount "$HOME/.local/bin"   /home/agent/.local/bin   true
add_mount "$HOME/.bun"         /home/agent/.bun         false

optional_env=""
if [ -S "${SSH_AUTH_SOCK:-}" ]; then
  add_mount "$SSH_AUTH_SOCK" /ssh-agent false
  optional_env="    environment:
      SSH_AUTH_SOCK: /ssh-agent
"
fi

override_args=()
if [ -n "$optional_volumes$optional_env" ]; then
  {
    echo "services:"
    echo "  agent:"
    printf '%s' "$optional_env"
    if [ -n "$optional_volumes" ]; then
      echo "    volumes:"
      printf '%s' "$optional_volumes"
    fi
  } > "$override"
  chmod 644 "$override"
  override_args=(-f "$override")
fi

# Reserva um nome para esta sessao: so uma sessao por vez segura o lock de cada
# nome, entao aberturas simultaneas nao escolhem o mesmo. O lock fica no fd 9
# ate o processo terminar, e o kernel o solta mesmo se ele for morto. Os arquivos
# nao sao apagados: apagar um lock em uso permitiria dois donos para o mesmo nome.
# Falha so se o nome estiver ocupado; sem lock disponivel, segue sem reserva.
reserve_name() { # nome
  local dir="${XDG_CONFIG_HOME:-$HOME/.config}/llm-agent/locks"
  command -v flock >/dev/null || return 0
  mkdir -p "$dir" 2>/dev/null || return 0
  # Abrir de novo no fd 9 solta o lock do nome anterior.
  { exec 9>"$dir/$1.lock"; } 2>/dev/null || return 0
  # Codigo 1 e nome ocupado; outro codigo e erro do proprio flock.
  flock -n 9 2>/dev/null || [ $? -ne 1 ]
}

# Nome do container: llm-agent-<comando>-<pasta do projeto>. O Docker so
# aceita [a-zA-Z0-9_.-] em nomes; o resto vira "-". Se o nome ja estiver em
# uso (outra sessao no mesmo projeto), acrescenta -2, -3, ...
# Grava em $name, e nao na saida: numa subshell ($(...)) o lock se perderia.
container_name() {
  local base n=1
  base="llm-agent-$(basename "${1:-agent}")-$(basename "$AGENT_WORKDIR")"
  base="$(printf '%s' "$base" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9_.-' '-')"
  name="$base"
  while ! reserve_name "$name" \
    || "${docker_cmd[@]}" container inspect "$name" >/dev/null 2>&1; do
    n=$((n + 1))
    name="$base-$n"
  done
}

# Verdadeiro se o usuario ja passou --remote-control (com ou sem nome).
has_remote_control_arg() {
  local arg
  for arg in "$@"; do
    case "$arg" in
      --remote-control | --remote-control=*) return 0 ;;
    esac
  done
  return 1
}

if [ "${1:-}" = "--build" ]; then
  shift
  build_image "$@"
else
  container_name "${1:-}"
  # O Claude Code abre com Remote Control (app Claude no celular e
  # claude.ai/code), nomeado como o container: claude-<pasta>[-N]. Sem nome,
  # ele usaria o hostname, que no container e um ID aleatorio.
  if [ "${1:-}" = claude ] && [ -z "${LLM_AGENT_NO_REMOTE_CONTROL:-}" ] \
    && ! has_remote_control_arg "$@"; then
    set -- claude --remote-control "${name#llm-agent-}" "${@:2}"
  fi
  compose "${override_args[@]}" run --rm --name "$name" agent "$@"
fi
