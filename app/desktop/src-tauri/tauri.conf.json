{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jarvis",
  "version": "1.3.0",
  "identifier": "dev.llmagent.jarvis",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": ["payload/*"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installerHooks": "./windows/hooks.nsh"
      },
      "wix": {
        "fragmentPaths": [
          "./windows/kill-jarvis.wxs"
        ],
        "componentGroupRefs": [
          "KillJarvisGroup"
        ]
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "gstreamer1.0-plugins-good"
        ]
      }
    }
  }
}
