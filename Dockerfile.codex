FROM node:22-bookworm

ARG USERNAME=fmota
ARG USER_UID=1000
ARG USER_GID=1000

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV PIPX_HOME=/opt/pipx
ENV PIPX_BIN_DIR=/usr/local/bin
ENV POETRY_VIRTUALENVS_IN_PROJECT=true
ENV CODEX_HOME=/home/${USERNAME}/.codex
ENV PATH=/home/${USERNAME}/.npm-global/bin:/usr/local/bin:$PATH

# Repositório oficial do GitHub CLI
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
  && install -m 0755 -d /etc/apt/keyrings \
  && curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
    -o /etc/apt/keyrings/githubcli-archive-keyring.gpg \
  && chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg \
  && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
    > /etc/apt/sources.list.d/github-cli.list \
  && rm -rf /var/lib/apt/lists/*

# Pacotes base
RUN apt-get update && apt-get install -y --no-install-recommends \
    bash \
    zsh \
    git \
    gh \
    openssh-client \
    keychain \
    wget \
    unzip \
    zip \
    less \
    nano \
    vim \
    jq \
    ripgrep \
    fd-find \
    fzf \
    tree \
    htop \
    build-essential \
    python3 \
    python3-pip \
    python3-venv \
    pipx \
    sudo \
  && ln -sf /usr/bin/fdfind /usr/local/bin/fd \
  && rm -rf /var/lib/apt/lists/*

# Usuário não-root. A imagem node já possui o usuário/grupo UID/GID 1000.
RUN set -eux; \
  existing_group="$(getent group "${USER_GID}" | cut -d: -f1 || true)"; \
  if [ -z "${existing_group}" ]; then \
    groupadd --gid "${USER_GID}" "${USERNAME}"; \
  elif [ "${existing_group}" != "${USERNAME}" ]; then \
    groupmod --new-name "${USERNAME}" "${existing_group}"; \
  fi; \
  existing_user="$(getent passwd "${USER_UID}" | cut -d: -f1 || true)"; \
  if [ -z "${existing_user}" ]; then \
    useradd --uid "${USER_UID}" --gid "${USER_GID}" -m -s /usr/bin/zsh "${USERNAME}"; \
  elif [ "${existing_user}" != "${USERNAME}" ]; then \
    usermod --login "${USERNAME}" --gid "${USER_GID}" --home "/home/${USERNAME}" --move-home --shell /usr/bin/zsh "${existing_user}"; \
  else \
    usermod --gid "${USER_GID}" --home "/home/${USERNAME}" --shell /usr/bin/zsh "${USERNAME}"; \
  fi; \
  mkdir -p "/home/${USERNAME}/.npm-global"; \
  chown -R "${USER_UID}:${USER_GID}" "/home/${USERNAME}"; \
  npm config --global set prefix /usr/local; \
  echo "${USERNAME} ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/${USERNAME}; \
  chmod 0440 /etc/sudoers.d/${USERNAME}

# Poetry via pipx
RUN pipx install poetry

# Codex CLI oficial via npm
RUN npm i -g @openai/codex

ENV NPM_CONFIG_PREFIX=/home/${USERNAME}/.npm-global

USER ${USERNAME}
WORKDIR /workspace

# npm global sem sudo para o usuário
RUN mkdir -p /home/${USERNAME}/.npm-global \
  && npm config set prefix /home/${USERNAME}/.npm-global

CMD ["zsh", "-lic", "codex"]
